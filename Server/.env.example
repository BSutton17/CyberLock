# Copy to Server/.env for local development. Nothing here is required locally:
# with no .env the server runs with guest login and the offline mock narrator.
# On Heroku, set these as config vars instead (see docs/DEPLOYMENT.md).

PORT=5000

# --- Sign-in ---------------------------------------------------------------
# Required in production: any long random string (e.g. `openssl rand -hex 32`).
# JWT_SECRET=
# Google OAuth Client ID (public, not a secret). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Guest login is on by default (locally and in production). Set to false to require Google.
# ALLOW_GUEST_LOGIN=true
# How long a sign-in lasts.
# SESSION_TTL=7d

# --- AI narrator -------------------------------------------------------------
# mock (offline, free, default) | gemini (free tier, good for testing) | anthropic (production)
AI_PROVIDER=mock
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
# ANTHROPIC_STORY_MODEL=claude-sonnet-5-5
# Cheaper option for quick combat lines: claude-haiku-4-5
# ANTHROPIC_COMBAT_MODEL=claude-sonnet-5-5
# Story decisions between fights before the next fight starts.
# STORY_DECISIONS_PER_INTERLUDE=3
# Max AI-written combat lines per minute (routine turns use the game's own text).
# AI_COMBAT_LINES_PER_MINUTE=12
# Fake latency for the mock narrator, in ms.
# MOCK_AI_DELAY_MS=400

# --- Production --------------------------------------------------------------
# Your client URL(s), comma separated. Required in production.
# ALLOWED_ORIGINS=https://your-site.netlify.app

# --- Pacing (milliseconds) ---------------------------------------------------
# ALLY_TURN_ADVANCE_DELAY_MS=2500
# COMBAT_START_ENEMY_DELAY_MS=6000
# ENEMY_TURN_TIMEOUT_MS=25000
# ALLY_TURN_TIMEOUT_MS=45000
# DISCONNECT_GRACE_MS=60000
